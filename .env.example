NODE_ENV=development
PORT=5000

MONGODB_URI="mongodb://localhost:27017/asterias-dev"

# Number of reverse proxies in front of this process. Traefik sets
# X-Forwarded-For; without trusting it every request looks like it comes from
# the proxy and the rate limiter counts the whole internet as one client.
TRUST_PROXY=1

# Comma-separated list of browser origins allowed to call the API. Unset falls
# back to the asteriashome.gr domains in production and localhost in dev.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Comma-separated list of origins accepted as a Stripe return destination.
# Unset falls back to the same defaults as CORS_ORIGINS.
RETURN_ORIGINS=http://localhost:3000,http://localhost:3001

# Development memory diagnostics. Off unless NODE_ENV=development or this is
# explicitly 'true'; nothing downstream acts on the findings.
NODE_ENABLE_MEMORY_MONITOR=false
MEMORY_WARNING_THRESHOLD=500
MEMORY_CHECK_INTERVAL=60000

# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-random-32-byte-secret
JWT_REFRESH_SECRET=replace-with-random-32-byte-secret

FRONTEND_URL=http://localhost:3000

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-before-seeding
ADMIN_NAME=Admin User

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Shared secret for the Booking.com webhook. The signature is verified over the
# raw request bytes, so this must match exactly what is configured at the OTA.
BOOKINGCOM_WEBHOOK_SECRET=replace-with-webhook-secret
