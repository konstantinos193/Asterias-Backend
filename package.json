{
  "name": "asterias-homes-backend",
  "version": "1.2.0",
  "description": "Backend API for Asterias Homes hotel booking system",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "build": "node scripts/build.js",
    "build:prod": "node scripts/build.js",
    "test": "node --test scripts/verify-auth-guards.js scripts/verify-availability.js scripts/verify-pricing.js scripts/verify-architecture.js",
    "test:watch": "node --test --watch scripts/verify-architecture.js",
    "test:cov": "node --experimental-test-coverage --test scripts/verify-auth-guards.js scripts/verify-availability.js scripts/verify-pricing.js scripts/verify-architecture.js",
    "test:debug": "node --inspect-brk --test --test-isolation=none scripts/verify-architecture.js",
    "test:e2e": "node scripts/build.js && node --test test/api.e2e.js",
    "seed": "ts-node src/seed.ts",
    "audit:endpoints": "node scripts/audit-endpoints.js",
    "test:auth": "node --test scripts/verify-auth-guards.js",
    "pretest": "node scripts/build.js"
  },
  "keywords": [
    "hotel",
    "booking",
    "api",
    "nestjs",
    "mongodb"
  ],
  "author": "Asterias Homes",
  "license": "MIT",
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/throttler": "^6.7.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4",
    "multer": "2.5.0",
    "nodemailer": "^10.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "puppeteer": "^25.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^23.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/puppeteer": "^7.0.4",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
