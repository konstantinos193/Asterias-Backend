{
  "compilerOptions": {
    "module": "commonjs",
    // This is an application, not a library: nothing consumes .d.ts files from
    // dist/, and emitting them wrote ~130 unused files per build.
    "declaration": false,
    // Comments are kept on purpose. Many of them record the bug that motivated
    // the current shape of a function, and stripping them from the shipped
    // build meant the running code could not be read for that context.
    "removeComments": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2021",
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "incremental": false,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    // TypeScript 7 removed "baseUrl"; "paths" now resolves relative to this
    // file, so this mapping works as written. It is kept rather than deleted
    // because it does resolve — but note that tsc only rewrites types, not
    // emitted require() calls, so an "@/..." import would need a runtime
    // resolver (tsconfig-paths) to work in dist/. Nothing imports that way yet.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}